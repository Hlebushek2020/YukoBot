<Window x:Class="YukoClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:viewModels="clr-namespace:YukoClient.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainViewModel}"
        Title="{Binding Path=Title, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
        Style="{DynamicResource WindowStyle}"
        Height="450"
        Width="800"
        FontSize="14"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding  Path=UpdateServerCollectionCommand}" />
        <KeyBinding Key="F11" Command="{Binding Path=FullscreenCommand }" />
    </Window.InputBindings>

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Loaded">
            <behaviors:InvokeCommandAction Command="{Binding WindowLoadedCommand}" />
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{DynamicResource YcHeaderStyle}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Ellipse Grid.Column="0"
                     Margin="10,5,0,5"
                     Width="60"
                     Height="60"
                     HorizontalAlignment="Left"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     StrokeThickness="2"
                     Stroke="{DynamicResource YcLogoBorder}"
                     Fill="{Binding Avatar, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5,0,0,0">

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Bottom"
                           Margin="0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource YcProfileUsernameStyle}"
                           Text="{Binding Username, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource TextBlockStyle}"
                           Text="{Binding UserId, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

            </Grid>

            <Button Grid.Column="3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Height="34"
                    Width="34"
                    Margin="5,0,10,0"
                    BorderThickness="0"
                    Padding="2"
                    Style="{DynamicResource YcMenuIconButtonStyle}"
                    Command="{Binding AppSettingsCommand}">
                <Image Source="/YukoClientBase;component/Resources/settings-48.png" />
            </Button>

        </Grid>

        <Grid Grid.Row="1" Margin="10,5,10,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" SelectionMode="Single"
                     ItemsSource="{Binding Servers, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                     SelectedItem="{Binding SelectedServer, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}">

                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Настроить"
                                  Command="{Binding ServerSettingsCommand}" />
                        <MenuItem Header="Удалить"
                                  Command="{Binding RemoveServerCommand}" />
                        <Separator />
                        <MenuItem Header="Обновить список"
                                  InputGestureText="F5"
                                  Command="{Binding UpdateServerCollectionCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Grid Height="70">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0"
                                     Margin="5,5,0,5"
                                     Width="60" Height="60"
                                     HorizontalAlignment="Left"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     Fill="{Binding Icon, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Grid Grid.Column="1"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="5,0,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Bottom"
                                           Margin="0"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource TitleTextBlockStyle}"
                                           Text="{Binding Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="1"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Style="{DynamicResource TextBlockStyle}"
                                           Text="{Binding Channels.Count, Mode=OneWay, UpdateSourceTrigger=PropertyChanged, StringFormat='Доступно {0} каналов'}" />
                            </Grid>

                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <GridSplitter Grid.Column="1"
                          Width="3"
                          Margin="5,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <Grid Grid.Column="2">

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <StackPanel Orientation="Horizontal" Height="22" VerticalAlignment="Top">

                        <Button ToolTip="Добавить правило"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding AddScriptCommand}">
                            <Image Source="/Resources/menu-add-32.png" />
                        </Button>

                        <Button ToolTip="Удалить правило"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding RemoveScriptCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-delete-32.png" />
                        </Button>

                        <Button ToolTip="Очистить"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ClearScriptsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-clear-32.png" />
                        </Button>

                        <Button ToolTip="Экспортировать правила"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ExportScriptsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-export-32.png" />
                        </Button>

                        <Button ToolTip="Импортировать правилa"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ImportScriptsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-import-32.png" />
                        </Button>

                        <Button ToolTip="Выполнить правила"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding RunScriptsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-start-32.png" />
                        </Button>

                        <Button ToolTip="Просмотреть ошибки"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ShowExecutionErrorsCommand}">
                            <Image Source="/Resources/menu-error-32.png" />
                        </Button>

                    </StackPanel>

                    <ListView Margin="0,26,0,0" SelectionMode="Single"
                              ItemsSource="{Binding Scripts, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedItem="{Binding SelectedScript, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Канал"
                                                DisplayMemberBinding="{Binding Channel.Name, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <GridViewColumn Header="Получение"
                                                DisplayMemberBinding="{Binding Mode.Title, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <GridViewColumn Header="Сообщение"
                                                DisplayMemberBinding="{Binding MessageId, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                <GridViewColumn Header="Количество"
                                                DisplayMemberBinding="{Binding Count, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                            </GridView>
                        </ListView.View>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Style.Triggers>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition
                                                Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}"
                                                Value="False" />
                                            <Condition
                                                Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                Value="False" />
                                            <Condition
                                                Binding="{Binding Path=CompletedWithErrors, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Background" Value="#3fff0000" />
                                            <Setter Property="BorderBrush" Value="#3fff0000" />
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition
                                                Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}"
                                                Value="False" />
                                            <Condition
                                                Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}"
                                                Value="False" />
                                            <Condition
                                                Binding="{Binding Path=CompletedWithErrors, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                                Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.Setters>
                                            <Setter Property="Background" Value="#3f00ff00" />
                                            <Setter Property="BorderBrush" Value="#3f00ff00" />
                                        </MultiDataTrigger.Setters>
                                    </MultiDataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                    </ListView>
                </Grid>

                <GridSplitter Grid.Row="1"
                              Height="3"
                              Margin="0,5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />

                <Grid Grid.Row="2">

                    <StackPanel Orientation="Horizontal" Height="22" VerticalAlignment="Top">

                        <Button ToolTip="Удалить"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding RemoveUrlCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-delete-32.png" />
                        </Button>

                        <Button ToolTip="Очистить"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ClearUrlsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-clear-32.png" />
                        </Button>

                        <Button ToolTip="Экспортировать список"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ExportUrlsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-export-32.png" />
                        </Button>

                        <Button ToolTip="Импортировать список"
                                Margin="0,0,2,0"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding ImportUrlsCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-import-32.png" />
                        </Button>

                        <Button ToolTip="Скачать"
                                Style="{DynamicResource YcMenuIconButtonStyle}"
                                Command="{Binding DownloadFilesCommand}">
                            <Image Source="/YukoClientBase;component/Resources/menu-download-32.png" />
                        </Button>

                    </StackPanel>

                    <ListBox SelectionMode="Single" Margin="0,26,0,0"
                             ItemsSource="{Binding Urls, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                             SelectedItem="{Binding SelectedUrl, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

            </Grid>

        </Grid>

    </Grid>
</Window>